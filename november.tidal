d11 $ every 2 (fast 4 . jux rev) $ n ("c'm[0 2*2 5<2 5 0 7>]") # sound "flbass"
# room 0.4 # sz 0.9
# gain "0.75"
# legato (range 0.5 0.65 sine)
# octave "4 5 4"

d11 silence

do
d12 $ qt $ someCycles (fast 2) $ jux (rev) $ n "0 <0 1 2> [3 4] 1" # sound "rash"
  # legato 5
  # octave "5 6"
-- # gain 0.7
-- # speed "1 0.5 0.1"

do
d13 $ sometimes (chunk 4 (|+ n "12")) $ qt $ sometimes (fast 2) $ jux (rev) $ n (scale "melodicMinorDesc" "0 <0 1 2> [3 4] 1*2")
  # sound "flbass"
  # distort 0.02
  # legato 5
  # gain (range 0.75 0.85 sine)
  # octave "7"
  # gain 0.75

d4 $ chop 4 $ loopAt 4 $ sound "yearn"
  # gain 0.8 # lpf (range 2000 5000 sine) # distort (range 0.1 0.3 $ slow 2 sine)

-- >>>>>
do
d1 silence
d4 $ chop 4 $ loopAt 4 $ sound "yearn"
-- # gain 0.85 # lpf 2000 # distort (range 0.1 0.7 $ slow 2 sine)
  # freeze 1 -- !!!!!!

d4 silence

do
d11 silence
d12 silence
d13 silence
d5 silence
d2 silence

d1 $ qt $ chop 2 $ sometimes (jux rev) $ loopAt 2 $ stack [
sound "bsbass:1",
sound "bsbass:5"
] # gain 0.8

d2 $ chop 2 $ loopAt 2 $ sound "cyborg:10"


d2 $ stack [ splice 10 "0..9" $ sound "break:17" # lpf 4000 # gain 1.1,
 chop 2 $ loopAt 2 $ sound "cyborg:10"]


-- d7 $ splice 10 "0..9" $ sound "break:17" # lpf 4000 -- ?

d5 $ loopAt 4 $ splice 8 "2 3 5 1 3 2 4 0" $ sound "rough-brass:1"
# speed 0.5
# gain 0.8
# djf 0.15

-- more intense
d5 $ stack [
loopAt 4 $ splice 8 "2 3 5 1 3 2 4 0" $ sound "rough-brass:1" # speed 0.5 # gain (range 0.6 1 sine),
 n "[0 1 2 4]" # sound "rash"
 ]


d5 silence

hush

//////////////

-- add layer
d10 $ chunk 4 (fast 2 . (|+ n 12)) $ layer [id, slow 2]
$ struct (iter 4 "t t f t")
$ n (scale "minPent" "0 .. 7") # sound "sinosc"
-- # gain 0.9


-- !ease in
d6
$ sometimes (striate 2 . jux rev)
$ struct (rarely inv "t(3,8)")
$ n (scale "hexSus" "[0 1 2] 3 4 5 6") # sound "sinosc"
  # gain 0.45
  # legato (range 0.2 1.5 sine)
  # djf 0.3
  -- # squiz (range 1 5 $ slow 2 sine)

//////////////

d7 $ sometimes (jux rev) $ slice "20" "0 .. [5 10]" $ sound "orchestra"
# gain (range 0.4 1.05 sine)
# speed 1.2
# gain 0.45

d7 silence

d9 $ sometimes (striate 2) $ fast 8 $ sound "vox-slice:2*2 vox-slice*2 vox-slice:20 vox-slice:10"
-- # n (irand 50)
# gain (range 0.5 0.7 sine)
# djf 0.35
# speed 0.8
-- # speed 0.6
# gain 1.1
-- # lpf (range 1000 6000 sine)

d7  $ sound "clubkick*4 gretsch(3,8)"
-- # n (irand 4)
# gain 1.1
-- # gain cosine

d2 $ off "0.25 0.5" (fast "2") $ off 0.75 (jux rev)
$ stack [sound "cpu2(3,8)" # gain (range 0.5 0.65 sine),
sound "kick(7,8)" # gain 0.5]

d11 silence

hush
