-- ease in
d13 $ striate "2 4" $ echo 4 0.2 0.75 $ sometimes(jux rev) $ n "c'sus2"
# sound "supervibe"
# legato 10
# room 0.35
# gain (range 0.2 0.7 $ slow 2 sine)
# octave "4"
# gain 0.65

d1 $ every 2 (scramble 2)
$ splice 8 10 $ sound "choir:1"
-- # gain "1.1 1.2"
-- # distort "0.2 0.3"
# lpf (range 500 1000 sine)
-- # octave "5 3"
# speed "1 0.8 0.6"
# gain 0.65



-- ///////////////

-- BREAKSBREAKSBREAKS
d8 $ splice 2 20 $ fast 2 $ every 3 (jux rev) $ sound "breaksss"
-- # gain 1.2
-- # gain "1.4 1.6"
# squiz "0..2"

d4 $ splice 2 8 $ sound "sk-breaks"
-- # gain 1.1

d3  $ stack [
splice 2 8 $ sound "amen_breaks",
fast 2 $ every 2 (jux rev ) $ sound "<amencutup*8>" # n (irand 8) # gain 1.2
]
-- # gain 1.1
-- # squiz "0..2"

fast 2 $ every 2 (jux rev ) $ sound "<amencutup*8>" # n (irand 8)


//////

-- $ off 0.2(+5)
-- $ chunk 4 (|+| note "5 -5")
do
d13 $ chunk 4 (|+| note "5 -5") $ sometimes(jux rev) $ n "c'sus2 ~"
  # sound "supervibe"
  # legato 5
  # room 0.35
  # gain (range 0.4 0.75 $ slow 2 sine)
  # octave "4 3"
  # gain 1.2


d8 $ qt $ iter 2 $ n "[0 .. 3]0*2" # sound "juno"
  # gain "0.8 0.9"
  # djf (range 0.3 0.6 $ slow 6 sine)
-- # speed (range 0.5 1 slow $ sine)

do
-- $ degradeBy (range 0.25 0.75 sine) --- c'sus4
d14
  $ striate "2 4 8"
  $ sometimes(jux rev) $ n "<f'm g'm ~>"
  # sound "supervibe"
  # legato 5
  # distort (range 0.2 0.5 $ slow 2 sine) -- MORE
  -- # gain "0.75 0.85"
  # octave "4 5"
  # gain 1.2

do

d15
  -- $ degradeBy "0.25 0.5 0.75"
  $ layer [id, slow 2, jux rev] $ striate "<4 2>" $ n "0 .. 3"
  # sound "superfm"
  # octave "3 2"
  # gain 0.5
  -- # distort "0.2 0.3 0.5"

d3  $ stack [
  splice 2 8 $ sound "amen_breaks"
]


d16 $ striate 4 $ echo 4 0.2 0.75 $ arp "diverge" $ n "c'sus2"
# sound "cs80lead"
# lpf 1000
# legato 5
# distort (range 0.2 0.8 sine) -- MORE
# gain (range 0.75 0.8 sine)
# gain 0.9
# octave "7 8"

hush

do
d1 silence
d3 silence
d2 silence
d4 silence
d9 silence
d8 silence
d10 silence
d7 silence
d5 silence

d15 silence
